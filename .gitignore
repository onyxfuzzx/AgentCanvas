# Local workspace data belongs outside source control. Do not ignore all JSON
# or Markdown: source schemas, examples, documentation and tests must stay visible.
/workspaces/
/task-areas/
/recovery/
/notes/
/workspace.json
/workspace.json.bak
/workspaces.json
/workspaces.json.bak
/tasks.json
/tasks.json.bak
/areas.json
/areas.json.bak
/agents.json
/agents.json.bak
/.workspace.lock
/.catalog.lock
/.tasks.lock
/.areas.lock
/.agents.lock

# Distribute binaries as release assets, never as source commits.
*.exe
*.dll
*.pdb
*.msi
*.msix
*.vsix
*.zip
*.dmp
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

