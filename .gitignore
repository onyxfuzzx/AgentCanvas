dist/
target/
coverage/
.cache/
.tools/
.local/
/artifacts/
/src-tauri/tauri.generated.json
/src-tauri/gen/

# Generated extension payload. Source, manifests and media stay public.
/extension/dist/
/extension/webview/
/extension/native/
/extension/package.nls.json
/extension/THIRD_PARTY.md
/extension/media/licenses/
/extension/LICENSE
/extension/LICENSE.txt

