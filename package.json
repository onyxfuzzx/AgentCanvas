{
  "name": "agent-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "vitest run --configLoader native",
    "lint": "eslint src",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "desktop:release": "node scripts/desktop.mjs build --bundles nsis,msi",
    "native:check": "node scripts/native-check.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.12",
    "@xterm/xterm": "5.6.0-beta.136",
    "@xterm/addon-webgl": "0.19.0-beta.136"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.3.5",
    "vitest": "4.1.4"
  }
}
