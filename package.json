{
  "name": "agent-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local spatial workspace for coding agents, terminals, tasks and review.",
  "repository": {
    "type": "git",
    "url": "https://github.com/onyxfuzzx/AgentCanvas.git"
  },
  "homepage": "https://github.com/onyxfuzzx/AgentCanvas#readme",
  "bugs": {
    "url": "https://github.com/onyxfuzzx/AgentCanvas/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "repo:audit": "node scripts/repo-audit.mjs",
    "site:check": "node scripts/site.mjs check",
    "site:build": "node scripts/site.mjs build",
    "site:preview": "node scripts/site.mjs serve",
    "site:browser-check": "node scripts/site-browser-check.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "vitest run --configLoader native",
    "lint": "eslint src extension/src",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run extension:check",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "desktop:release": "node scripts/desktop.mjs build --bundles nsis,msi",
    "desktop:bundle": "node scripts/desktop.mjs bundle --bundles nsis,msi",
    "release:prepare": "node scripts/release.mjs",
    "release:stage": "node scripts/release.mjs --stage-only",
    "native:check": "node scripts/native-check.mjs",
    "extension:build": "node scripts/extension.mjs",
    "extension:package": "node scripts/extension.mjs --package",
    "extension:check": "tsc -p extension/tsconfig.json && vitest run --configLoader native --config extension/vitest.config.mjs"
  },
  "dependencies": {
    "@xterm/addon-webgl": "0.19.0-beta.136",
    "@xterm/xterm": "5.6.0-beta.136",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.3.5",
    "vitest": "4.1.4"
  }
}
